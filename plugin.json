{
  "$schema": "./sdk/plugin.schema.json",
  "id": "zlib.books",
  "name": "Z-Library",
  "version": "2.0.3",
  "api": 1,
  "dalibre": ">=0.6.0",
  "icon": "book-open",
  "description": "Search, browse and download books from Z-Library, with the zlib CLI",
  "author": "guesq",
  "homepage": "https://github.com/guesq/dalibre-zlib",
  "license": "MIT",
  "capabilities": {
    "bookSource": {
      "collections": true,
      "filters": [
        {
          "key": "format",
          "title": "Format",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "title": "Any format"
            },
            {
              "value": "epub",
              "title": "EPUB"
            },
            {
              "value": "pdf",
              "title": "PDF"
            },
            {
              "value": "mobi",
              "title": "MOBI"
            },
            {
              "value": "azw3",
              "title": "AZW3"
            },
            {
              "value": "fb2",
              "title": "FB2"
            },
            {
              "value": "djvu",
              "title": "DJVU"
            },
            {
              "value": "txt",
              "title": "TXT"
            }
          ]
        },
        {
          "key": "language",
          "title": "Language",
          "type": "language",
          "options": [
            {
              "value": "",
              "title": "Any language"
            },
            {
              "value": "zh"
            },
            {
              "value": "en"
            },
            {
              "value": "ja"
            },
            {
              "value": "fr"
            },
            {
              "value": "de"
            },
            {
              "value": "es"
            },
            {
              "value": "ru"
            },
            {
              "value": "it"
            },
            {
              "value": "pt"
            },
            {
              "value": "ko"
            }
          ]
        },
        {
          "key": "sort",
          "title": "Sort",
          "type": "select",
          "default": "popular",
          "options": [
            {
              "value": "popular",
              "title": "Most popular"
            },
            {
              "value": "bestmatch",
              "title": "Best match"
            },
            {
              "value": "date",
              "title": "Recently added"
            },
            {
              "value": "year",
              "title": "Year (newest)"
            },
            {
              "value": "titleA",
              "title": "Title (A-Z)"
            },
            {
              "value": "filesize",
              "title": "File size (largest)"
            },
            {
              "value": "filesizeA",
              "title": "File size (smallest)"
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "hosts": [
      "z-library.sk"
    ],
    "covers": "any"
  },
  "settings": [
    {
      "key": "email",
      "title": "Email",
      "description": "Your Z-Library account. Leave empty if you signed in with zlib login."
    },
    {
      "key": "password",
      "title": "Password",
      "type": "secret"
    },
    {
      "key": "domain",
      "title": "Domain",
      "description": "A Z-Library mirror, as https://z-lib.gd. Leave empty for zlib's own."
    }
  ],
  "tools": {
    "zlib": {
      "version": "0.0.14",
      "min": "0.0.13",
      "homepage": "https://github.com/heartleo/zlib",
      "license": "MIT",
      "packages": {
        "brew": "heartleo/tap/zlib-cli",
        "winget": "heartleo.zlib"
      },
      "platforms": {
        "darwin-amd64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_darwin_x86_64.tar.gz",
          "sha256": "5249c40ba485932b31186f30b2e6b6725c9f1f985b25765e02d9c1bb71cbaf7b",
          "size": 6149491,
          "bin": "zlib"
        },
        "darwin-arm64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_darwin_arm64.tar.gz",
          "sha256": "0442dfd5d4e6482e8635a5b2441f68a83abbc14d84e22e1d8a760560ab7b72ed",
          "size": 5729797,
          "bin": "zlib"
        },
        "linux-amd64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_linux_x86_64.tar.gz",
          "sha256": "d9a066b7f97edc4f6046d342183cd82d095ba311e880fbf3bc1dd0b341362651",
          "size": 6047147,
          "bin": "zlib"
        },
        "linux-arm64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_linux_arm64.tar.gz",
          "sha256": "1abcefcc5818c9647060c8ba586b4947fad726b7e20e2d27de6622ae9a1fffa9",
          "size": 5500872,
          "bin": "zlib"
        },
        "windows-amd64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_windows_x86_64.zip",
          "sha256": "57948e02984edeab21ffcb94c54fc16cc2802acc1e2a1864e356469999523372",
          "size": 6228613,
          "bin": "zlib.exe"
        },
        "windows-arm64": {
          "url": "https://github.com/heartleo/zlib/releases/download/v0.0.14/zlib_0.0.14_windows_arm64.zip",
          "sha256": "8febd034ff8a25ba5476f87d3185dd71b73da0330f4f0baf1adfc4c58c2cae8b",
          "size": 5586932,
          "bin": "zlib.exe"
        }
      }
    }
  }
}
