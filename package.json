{
  "name": "dalibre-zlib-bridge",
  "version": "1.2.0",
  "description": "Cross-platform Z-Library book source plugin and local HTTP bridge for Dalibre",
  "type": "module",
  "license": "MIT",
  "author": "guesq",
  "homepage": "https://github.com/guesq/dalibre-zlib",
  "repository": {
    "type": "git",
    "url": "https://github.com/guesq/dalibre-zlib.git"
  },
  "bin": {
    "dalibre-zlib-bridge": "./plugins/zlib/bridge.mjs"
  },
  "files": [
    "plugins/zlib/",
    "bridge/",
    "plugin.json",
    "main.js",
    "dalibre.d.ts",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "postinstall": "node ./plugins/zlib/bridge.mjs postinstall",
    "start": "node ./plugins/zlib/bridge.mjs start",
    "stop": "node ./plugins/zlib/bridge.mjs stop",
    "restart": "node ./plugins/zlib/bridge.mjs restart",
    "status": "node ./plugins/zlib/bridge.mjs status",
    "install-service": "node ./plugins/zlib/bridge.mjs install-service",
    "uninstall-service": "node ./plugins/zlib/bridge.mjs uninstall-service",
    "test": "node ./scripts/test-plugin.mjs",
    "test:e2e": "node ./scripts/test-e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
